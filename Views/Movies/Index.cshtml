
@model IEnumerable<Wilson_Movies_Project.Models.Movie>

@{
    // Set the title displayed in the browser tab.
    ViewData["Title"] = "My Movies";
}

<h1>My Movies</h1>

<!-- Link to the page for creating a new movie. -->
<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Movie
    </a>
</p>

<!-- Search form: sends the title and genre filters using HTTP GET. -->
<form asp-controller="Movies" asp-action="Index" method="get" class="mb-4">

    <div class="row g-3">

        <!-- Search movies by title. -->
        <div class="col-md-5">
            <label for="searchString" class="form-label">
                Movie Title
            </label>

            <input type="text"
                   id="searchString"
                   name="searchString"
                   value="@ViewBag.SearchString"
                   class="form-control"
                   placeholder="Enter a movie title..." />
        </div>

        <!-- Filter movies by genre. -->
        <div class="col-md-4">
            <label for="movieGenre" class="form-label">
                Genre
            </label>

            <select id="movieGenre"
                    name="movieGenre"
                    class="form-select">

                <option value="">All Genres</option>

                <!-- Display available genres from the database. -->
                @foreach (var genre in (ViewBag.Genres as IEnumerable<string>
                    ?? Enumerable.Empty<string>()))
                {
                    <option value="@genre"
                            selected="@(ViewBag.MovieGenre == genre)">
                        @genre
                    </option>
                }
            </select>
        </div>

        <!-- Buttons to submit or clear the search. -->
        <div class="col-md-3 d-flex align-items-end gap-2">

            <button type="submit" class="btn btn-primary">
                Filter
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Clear
            </a>

        </div>

    </div>
</form>

<!-- Display the movies returned by the search. -->
<table class="table table-striped">

    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.ReleaseDate)</th>
            <th>@Html.DisplayNameFor(model => model.Genre)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <!-- Display the saved rating as five stars. -->
                <td>
                    @{
                        // Convert the saved rating into a number of stars.
                        int rating = 0;
                        int.TryParse(item.Rating, out rating);

                        // Keep the rating between 0 and 5.
                        rating = Math.Clamp(rating, 0, 5);
                    }

                    <span class="text-warning"
                          title="@rating out of 5 stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= rating)
                            {
                                @:★
                            }
                            else
                            {
                                @:☆
                            }
                        }
                    </span>
                </td>

                <!-- Links to the movie CRUD operations. -->
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>

<!-- Display a message if no movies match the search criteria. -->
@if (!Model.Any())
{
    <p class="alert alert-warning">
        No movies were found matching your search criteria.
    </p>
}
